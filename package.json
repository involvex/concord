{
  "name": "@involvex/concord",
  "author": "involvex",
  "version": "1.4.0",
  "description": "A terminal user interface client for Discord",
  "bin": {
    "concord": "./bin/concord.js"
  },
  "scripts": {
    "build": "cargo build --release",
    "start": "bun bin/concord.js",
    "dev": "cargo run",
    "format": "cargo fmt",
    "lint": "cargo clippy -- -D warnings && cargo check",
    "prepublishOnly": "bun run lint && bun run format &&  cargo build --release"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/involvex/concord"
  },
  "keywords": ["discord", "tui", "terminal", "ratatui", "client"],
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "Readme.md",
    "target/release",
    "bin/concord.js"
  ],
  "sponsor": {
    "url": "https://github.com/sponsors/involvex"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/involvex"
  }
}